{
  "name": "@waishnav/devspace",
  "version": "1.0.7",
  "description": "Expose a secure local coding workspace through an MCP server.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.19 <27"
  },
  "bin": {
    "devspace": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "scripts",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:app && tsc -p tsconfig.build.json",
    "build:app": "vite build",
    "dev": "node scripts/dev-server.mjs",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "start": "node dist/cli.js serve",
    "test": "node --test scripts/dev-command.test.mjs && tsx src/config.test.ts && tsx src/request-meta.test.ts && tsx src/incoming-artifacts.test.ts && tsx src/artifact-download.test.ts && tsx src/ui/card-types.test.ts && tsx src/ui/patch-display.test.ts && tsx src/ui/tool-display.test.ts && tsx src/apply-patch.test.ts && tsx src/process-platform.test.ts && tsx src/process-sessions.test.ts && tsx src/mcp-sessions.test.ts && tsx src/server-shutdown.test.ts && tsx src/local-agent-runtime.test.ts && tsx src/local-agent-adapters.test.ts && tsx src/local-agent-availability.test.ts && tsx src/local-agent-profiles.test.ts && tsx src/local-agent-targets.test.ts && tsx src/local-agent-store.test.ts && tsx src/roots.test.ts && tsx src/skills.test.ts && tsx src/workspaces.test.ts && tsx src/workspace-conversation.test.ts && tsx src/review-checkpoints.test.ts && tsx src/server.test.ts && tsx src/oauth-store.test.ts && npm exec -- tsx --test src/oauth-device-store.test.ts && tsx src/cli.test.ts && tsx src/ui/language-catalog.test.ts && tsx src/metrics.test.ts",
    "test:observability": "node scripts/validate-observability.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "npm run build && node --test scripts/e2e-http-mcp.test.mjs",
    "e2e:idempotency": "npm run build && node --test scripts/e2e-http-mcp-idempotency.test.mjs",
    "test:idempotency:p1": "tsx --test scripts/e2e-idempotency-p1.test.ts",
    "prd:reverse": "tsx src/reverse-engineering/cli.ts full --root . --output artifacts/canonical-360 --format both",
    "prd:reverse:strict": "tsx src/reverse-engineering/cli.ts full --root . --output artifacts/canonical-360 --format both --strict --fail-on P1",
    "test:prd-reverse": "tsx --test scripts/canonical-360.test.ts",
  "test:oauth-device": "npm exec -- tsx --test src/oauth-device-store.test.ts",
  "e2e:oauth-device": "node --test scripts/e2e-oauth-device.test.mjs",
  "e2e:oauth-device-cli": "node --test scripts/e2e-oauth-device-cli.test.mjs",
    "coverage": "c8 --all --src=src --extension=.ts --reporter=text --reporter=lcov npm test",
    "coverage:check": "c8 --all --src=src --extension=.ts --check-coverage --lines=60 --functions=55 --branches=45 --statements=60 --reporter=text --reporter=lcov npm test",
    "bundle:audit": "node scripts/audit-ui-bundle.mjs",
    "bundle:audit:check": "node scripts/audit-ui-bundle.mjs --check",
    "test:bundle-audit": "node --test scripts/audit-ui-bundle.test.mjs",
    "mcp:monitor": "powershell -ExecutionPolicy Bypass -File scripts/mcp-monitor.ps1",
    "mcp:monitor:once": "powershell -ExecutionPolicy Bypass -Command \"& .\\scripts\\mcp-monitor.ps1 -IntervalSeconds 0\"",
    "mcp:load:log": "node scripts/mcp-load-log.mjs",
    "presentation:script": "node scripts/generate-e2e-presentation-script.mjs",
    "security:p0": "python scripts/run-p0-negative-matrix.py --repo . --command \"node --test scripts/e2e-http-mcp-negative.test.mjs\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.200",
    "@clack/prompts": "^1.5.1",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.142.5",
    "@opencode-ai/sdk": "^1.17.13",
    "@pierre/diffs": "^1.2.5",
    "better-sqlite3": "^12.10.0",
    "diff": "^8.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "lucide": "^1.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semver": "^7.8.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "c8": "^12.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "ws": "8.21.0",
    "undici": "8.9.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
